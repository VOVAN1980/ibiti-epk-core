# =============================================================================
# EPK — template for the local .env (BSC Testnet, chainId 97).
# Copy to .env and fill in. NEVER commit real keys; .env is git-ignored.
# Use TESTNET-ONLY keys that hold nothing of value.
# =============================================================================

# ---- Network ----------------------------------------------------------------
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# BscScan / Etherscan v2 API key (contract verification)
ETHERSCAN_API_KEY=

# ---- Deployer = owner (testnet key, 0x-prefixed) -------------------------------
PRIVATE_KEY=0x...
OWNER=0xYourOwnerAddress

# ---- EPK v2 test roles (separate testnet keys; each needs a little tBNB) -------
V2_GUARDIAN1_PRIVATE_KEY=0x...
V2_GUARDIAN2_PRIVATE_KEY=0x...
V2_SESSION_MANAGER_PRIVATE_KEY=0x...
V2_RECOVERY_PRIVATE_KEY=0x...
V2_AGENT_PRIVATE_KEY=0x...
# vault timelock delay in seconds (minimum 3600; upgrades wait >= 2 days on mainnets, 5 minutes on BSC Testnet (2.1+))
V2_DELAY=3600

# ---- EPK v2 deployed addresses (see deployments/bsc-testnet/*.json) -----------
V2_IMPLEMENTATION=
V2_REGISTRY=
V2_FACTORY=
V2_RELEASE_2_1=
V2_TEST_TOKEN=
V2_VAULT=

# ---- Watchtower alerts (watchtower/README.md) ------------------------------------
# Telegram: create a bot with the official @BotFather; its token goes here (never in chat or git).
# Then write to the bot and run: python watchtower/epk_watchtower.py --config <cfg> --telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook: alerts as signed JSON to your own system (optional)
WATCHTOWER_WEBHOOK_URL=
WATCHTOWER_WEBHOOK_SECRET=
