{
  "name": "@ibiti/epk-sdk",
  "version": "2.0.0-preview.0",
  "description": "PREVIEW (testnet only, not audited) — TypeScript SDK for EPK v2 vaults: per-customer vaults for AI agents and trading bots, agent sessions, guarded swaps (DexGuard), timelock, upgrades. Built on viem.",
  "license": "MIT AND BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "example:smoke": "tsx -r dotenv/config examples/smoke.ts",
    "postbuild": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','abi');const dst=path.join('dist','abi');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(path.join(src,f),path.join(dst,f));}console.log('ABI copied to',dst);\"",
    "example:write": "tsx -r dotenv/config examples/write.ts",
    "example:setup": "tsx -r dotenv/config examples/setup.ts",
    "test:v2": "tsx --test test/v2/*.test.ts",
    "example:v2": "tsx examples/v2-guarded-swap.ts",
    "example:v2-upgrade": "tsx examples/v2-upgrade.ts",
    "example:v2-quickstart": "tsx examples/v2-quickstart.ts",
    "build:abi": "cd .. && forge build && cd sdk && node scripts/sync-abi.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VOVAN1980/ibiti-epk-core.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/VOVAN1980/ibiti-epk-core/blob/master/docs/INTEGRATION_v2.md",
  "keywords": [
    "epk",
    "vault",
    "ai-agents",
    "trading-bots",
    "viem",
    "bnb-chain",
    "security",
    "smart-contracts"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  }
}
