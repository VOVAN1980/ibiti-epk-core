# Optional: your own BSC Testnet RPC (default: https://bsc-testnet-rpc.publicnode.com)
BSC_TESTNET_RPC=

# Only for `npm run example:v2-quickstart` (creates your own vault on BSC Testnet).
# Use a separate TEST key with a little tBNB. Never commit real keys: copy this file to sdk/.env (git-ignored).
ADMIN_PRIVATE_KEY=
